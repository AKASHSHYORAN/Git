{
	"name": "DS_ADLS_Sink_Parameterized",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLSGen2_Retail",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_container": {
				"type": "string",
				"defaultValue": "0"
			},
			"p_folder": {
				"type": "string",
				"defaultValue": "0"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": "@dataset().p_file_name",
				"folderPath": "@dataset().p_folder",
				"fileSystem": {
					"value": "@dataset().p_container",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}